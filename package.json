{
  "name": "youtube-research-mcp",
  "version": "0.2.0",
  "description": "Keyless YouTube MCP server built for research agents: multi-query search with transcript highlights, batch fetch of transcript ranges, chapters, comments and channel outliers.",
  "type": "module",
  "bin": {
    "youtube-research-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    ".claude-plugin",
    ".codex-plugin",
    ".agents",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --banner:js='import { createRequire } from \"module\"; const require = createRequire(import.meta.url);'",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx test/smoke.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "youtube",
    "youtube-transcript",
    "youtube-search",
    "claude-code",
    "claude-plugin",
    "codex",
    "codex-plugin",
    "ai-agent",
    "agent-skill",
    "research",
    "video-frames"
  ],
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^20.19.43",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "undici": "^6.29.0",
    "zod": "^4.6.7"
  },
  "homepage": "https://youtube-research-mcp.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jindratilk/youtube-research-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jindratilk/youtube-research-mcp/issues"
  },
  "author": "jindratilk"
}
